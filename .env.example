# App
APP_NAME=Noir Atelier
APP_ENV=development
DEMO_MODE=true
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FORMAT=console
API_BASE_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (Primary DB)
DATABASE_URL=postgresql+asyncpg://noir:noir@localhost:5432/noir
DATABASE_SYNC_URL=postgresql+psycopg://noir:noir@localhost:5432/noir
DB_POOL_MODE=queue
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis (Cache, Sessions, Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector DB (Qdrant)
VECTOR_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=noir_products

# Search (postgres | elasticsearch)
SEARCH_PROVIDER=postgres
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=noir_products

# Embeddings (local | openai | voyage)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
VOYAGE_API_KEY=

# LLM & Agents (anthropic | openai | hybrid)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=claude-opus-4-1
LLM_MODEL_FAST=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=30
AGENT_MAX_STEPS=6
AGENT_CHECKPOINTER=postgres

# Object Storage (local | minio | s3)
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
MEDIA_BASE_URL=http://localhost:8000/media
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth & Security
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_HASHER=argon2
SERVICE_ACCOUNT_SECRET=change-me-service-secret

# Rate Limits (requests per minute)
RATE_LIMIT_AGENT=100
RATE_LIMIT_CUSTOMER=60
RATE_LIMIT_ANON=30

# Payments & Shipping (mock | razorpay / shiprocket)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SUCCESS_RATE=0.95
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Notifications (console | smtp | ses / msg91)
EMAIL_PROVIDER=console
EMAIL_FROM=care@noir.test
SMS_PROVIDER=console

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_URL=http://localhost:8001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret

# Legacy Prototype Compatibility
SUPPORT_AGENT_BACKEND=hybrid
USE_LIVE_LLM=0
CLAUDE_CLI_PATH=
NOIR_ATELIER_DATA_DIR=./data
NOIR_ATELIER_SQLITE_DB=./data/noir_atelier.db
